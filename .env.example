# رابط قاعدة البيانات - SQLite افتراضيًا، يمكن استبدالها بـ PostgreSQL أو MySQL
# مثال PostgreSQL: postgresql://user:password@localhost:5432/hr_system
DATABASE_URL=sqlite:///./hr_system.db

# مفتاح التشفير الخاص بالـ JWT - غيّره في بيئة الإنتاج
SECRET_KEY=change-this-secret-key-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# بيانات أول حساب مدير يتم إنشاؤه تلقائيًا عند أول تشغيل (seed)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_FULL_NAME=System Manager
FIRST_ADMIN_EMAIL=admin@company.com
